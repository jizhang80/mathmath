{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmath.local/contracts/telemetry-batch.schema.json",
  "title": "telemetry-batch",
  "type": "object",
  "properties": {
    "format_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "app_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "bundle_versions": {
      "type": "object",
      "properties": {
        "graph": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "spine": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "objects": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "required": [
        "graph",
        "spine",
        "objects"
      ],
      "additionalProperties": false
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "session"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "count"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "expedition"
                ]
              },
              "started": {
                "type": "integer",
                "minimum": 0
              },
              "completed": {
                "type": "integer",
                "minimum": 0
              },
              "abandoned": {
                "type": "integer",
                "minimum": 0
              },
              "unit_scoped": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "started",
              "completed",
              "abandoned",
              "unit_scoped"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "item_result"
                ]
              },
              "node_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "correct": {
                "type": "boolean"
              },
              "retry": {
                "type": "boolean"
              },
              "tier": {
                "type": "integer",
                "enum": [
                  0,
                  1
                ]
              }
            },
            "required": [
              "kind",
              "node_id",
              "correct",
              "retry",
              "tier"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "edge_observation"
                ]
              },
              "edge_id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+-->-[a-z0-9-]+$"
              },
              "upstream_state": {
                "type": "string",
                "enum": [
                  "cleared",
                  "blocked",
                  "fog"
                ]
              },
              "downstream_result": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            },
            "required": [
              "kind",
              "edge_id",
              "upstream_state",
              "downstream_result"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "marker"
                ]
              },
              "course_code": {
                "type": "string",
                "pattern": "^[A-Z]{3}[1-4][A-Z]$"
              },
              "unit_id": {
                "type": "string",
                "pattern": "^[A-Z]{3}[1-4][A-Z]\\.u[1-9][0-9]*$"
              },
              "moves": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "course_code",
              "unit_id",
              "moves"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "landmark_tap"
                ]
              },
              "landmark_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "landmark_id",
              "count"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "diagnosis"
                ]
              },
              "origin_node": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "candidate_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "refuted",
                  "confirmed",
                  "unconfirmed",
                  "capped"
                ]
              },
              "error_type_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "tier": {
                "type": "integer",
                "enum": [
                  0,
                  1
                ]
              }
            },
            "required": [
              "kind",
              "origin_node",
              "outcome",
              "tier"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "fallback"
                ]
              },
              "task": {
                "type": "string",
                "enum": [
                  "classify",
                  "reword"
                ]
              },
              "reason": {
                "type": "string",
                "enum": [
                  "below_threshold",
                  "unavailable",
                  "timeout",
                  "guardrail"
                ]
              }
            },
            "required": [
              "kind",
              "task",
              "reason"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "capability"
                ]
              },
              "tier1_available": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "tier1_available"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "return"
                ]
              },
              "day_bucket": {
                "type": "string",
                "enum": [
                  "1",
                  "2-3",
                  "4-7",
                  "8-14",
                  "15-30",
                  "31+"
                ]
              }
            },
            "required": [
              "kind",
              "day_bucket"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "format_version",
    "app_version",
    "bundle_versions",
    "day",
    "events"
  ],
  "additionalProperties": false
}
